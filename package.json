{
  "name": "sentinel-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Hackathon project for scanning logs and text for exposed secrets and risky data.",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"node --watch backend/server.js\" \"npm --prefix frontend run dev\"",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
